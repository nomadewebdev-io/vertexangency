# Vertex Agency - Modèle de Configuration d'Environnement (.env)
# Copiez ce fichier sous '.env' et configurez vos variables réelles en local.
# NE JAMAIS COMMITER LE FICHIER .env CONTENANT DES CLÉS RÉELLES DANS GIT.

# URL de l'API backend / Endpoint de formulaire (optionnel)
VITE_API_BASE_URL=https://api.vertexagency.sn

# Clé de service ou endpoint de contact (si applicable)
VITE_CONTACT_FORM_ENDPOINT=https://api.vertexagency.sn/contact

# Environnement d'exécution
VITE_APP_ENV=development
